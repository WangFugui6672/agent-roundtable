# 后端本地配置。复制为 .env 后按需修改；不要把真实 .env 提交到仓库。
DATABASE_URL=postgres://roundtable:roundtable@127.0.0.1:5432/roundtable
# 本地单进程开发可留空；Docker Compose 和生产必须使用 Redis，保证跨进程广播。
REDIS_URL=redis://127.0.0.1:6379/0
# Celery worker/beat 默认复用 REDIS_URL；需要独立 broker 时可覆盖。
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# 单元测试或无 worker 的本地调试可设为 1，验证任务调用路径。
CELERY_TASK_ALWAYS_EAGER=0
# 中国大陆网络可临时指定 Docker 构建镜像源；留空时使用官方 PyPI。
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
DJANGO_SECRET_KEY=dev-insecure-secret-key
# 保持 0，所有非 2xx 才会返回 JSON 错误信封；要看调试页面时用 `DJANGO_DEBUG=1 make backend-run`。
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# WebSocket 游标补发窗口；窗口外客户端会收到完整 room.joined 快照并重置游标。
ROOM_EVENT_REPLAY_WINDOW_DAYS=90
# 圆桌及关联数据的最后活动保留天数；由 purge_roundtables 执行清理。
ROUNDTABLE_RETENTION_DAYS=90
# 仅供 docker compose 覆盖；公开部署前必须替换所有默认凭据与密钥。
POSTGRES_DB=roundtable
POSTGRES_USER=roundtable
POSTGRES_PASSWORD=roundtable
POSTGRES_PORT=5432
BACKEND_PORT=8000
